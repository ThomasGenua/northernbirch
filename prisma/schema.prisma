generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ MEMBERS ============
model Member {
  id              String   @id @default(cuid())
  memberNumber    String   @unique
  firstName       String
  lastName        String
  email           String   @unique
  phone           String?
  dateOfBirth     DateTime?
  preferredLang   Language @default(EN)
  passwordHash    String
  identityVerified Boolean @default(false)
  kycStatus       KYCStatus @default(PENDING)
  branchId        String?
  branch          Branch?  @relation(fields: [branchId], references: [id])
  memberSince     DateTime @default(now())
  lastLogin       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  accounts        Account[]
  policies        Policy[]
  claims          Claim[]
  appointments    Appointment[]
  threads         MessageThread[]
  notifications   Notification[]
  quotes          Quote[]
  documents       Document[]
  transactions    Transaction[]
  transfers       Transfer[]
  creditScore     CreditScore?
  healthAssessments HealthAssessment[]
  portfolios      Portfolio[]
  trades          Trade[]
  watchlist       Watchlist[]
  savingsGoals    SavingsGoal[]

  @@index([email])
  @@index([memberNumber])
}

enum Language {
  EN
  EST
  LAT
}

enum KYCStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

// ============ BRANCHES ============
model Branch {
  id          String   @id @default(cuid())
  name        String
  address     String
  city        String
  province    String   @default("ON")
  postalCode  String
  phone       String
  hours       Json
  latitude    Float?
  longitude   Float?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  members     Member[]
  appointments Appointment[]
}

// ============ ACCOUNTS ============
model Account {
  id            String      @id @default(cuid())
  memberId      String
  member        Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  accountNumber String      @unique
  type          AccountType
  balance       Decimal     @db.Decimal(15, 2) @default(0)
  currency      String      @default("CAD")
  status        AccountStatus @default(ACTIVE)
  openedAt      DateTime    @default(now())
  closedAt      DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  transactions  Transaction[]

  @@index([memberId])
}

enum AccountType {
  CHEQUING
  SAVINGS
  TFSA
  RRSP
  FHSA
  RESP
  GIC
  MORTGAGE
  LOAN
  LINE_OF_CREDIT
}

enum AccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

// ============ TRANSACTIONS ============
model Transaction {
  id          String          @id @default(cuid())
  accountId   String
  account     Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  memberId    String
  member      Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amount      Decimal         @db.Decimal(15, 2)
  type        TransactionType
  description String
  category    String?
  merchantName String?
  status      TransactionStatus @default(POSTED)
  postedAt    DateTime        @default(now())
  createdAt   DateTime        @default(now())

  @@index([accountId])
  @@index([memberId, postedAt])
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT
  PURCHASE
  PAYMENT
  FEE
  INTEREST
  REFUND
  INSURANCE_PREMIUM
  INTL_TRANSFER
}

enum TransactionStatus {
  PENDING
  POSTED
  REVERSED
}

// ============ INSURANCE POLICIES ============
model Policy {
  id              String         @id @default(cuid())
  memberId        String
  member          Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  policyNumber    String         @unique
  type            PolicyType
  provider        InsuranceProvider
  status          PolicyStatus   @default(ACTIVE)
  coverageAmount  Decimal?       @db.Decimal(15, 2)
  monthlyPremium  Decimal        @db.Decimal(10, 2)
  annualPremium   Decimal        @db.Decimal(10, 2)
  deductible      Decimal?       @db.Decimal(10, 2)
  startDate       DateTime
  renewalDate     DateTime
  endDate         DateTime?
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  claims          Claim[]
  documents       Document[]

  @@index([memberId])
  @@index([renewalDate])
}

enum PolicyType {
  TERM_LIFE
  PERMANENT_LIFE
  CRITICAL_ILLNESS
  DISABILITY
  MORTGAGE_PROTECTION
  HOME
  AUTO
  TENANT
  CO_OP
  TRAVEL
  PET
  GROUP_BENEFITS
  COMMERCIAL
  KEY_PERSON
}

enum InsuranceProvider {
  THE_PERSONAL
  CUMIS
  MANULIFE
  COOPERATORS
}

enum PolicyStatus {
  ACTIVE
  PENDING
  LAPSED
  CANCELLED
  CLAIM_IN_PROGRESS
}

// ============ CLAIMS ============
model Claim {
  id              String      @id @default(cuid())
  claimNumber     String      @unique
  memberId        String
  member          Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  policyId        String?
  policy          Policy?     @relation(fields: [policyId], references: [id])
  type            ClaimType
  status          ClaimStatus @default(SUBMITTED)
  description     String      @db.Text
  incidentDate    DateTime?
  filedDate       DateTime    @default(now())
  resolvedDate    DateTime?
  amountClaimed   Decimal?    @db.Decimal(15, 2)
  amountApproved  Decimal?    @db.Decimal(15, 2)
  adjusterName    String?
  adjusterPhone   String?
  documents       Document[]
  notes           Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([memberId])
  @@index([status])
}

enum ClaimType {
  HOME
  AUTO
  TRAVEL
  LIFE
  CRITICAL_ILLNESS
  DISABILITY
  MORTGAGE_PROTECTION
  COMMERCIAL
  GROUP_BENEFITS
}

enum ClaimStatus {
  SUBMITTED
  UNDER_REVIEW
  ADDITIONAL_INFO_NEEDED
  APPROVED
  PARTIALLY_APPROVED
  DENIED
  PAID
  CLOSED
}

// ============ QUOTES ============
model Quote {
  id              String     @id @default(cuid())
  memberId        String?
  member          Member?    @relation(fields: [memberId], references: [id], onDelete: SetNull)
  type            QuoteType
  inputs          Json
  monthlyPremium  Decimal    @db.Decimal(10, 2)
  annualPremium   Decimal    @db.Decimal(10, 2)
  coverageAmount  Decimal?   @db.Decimal(15, 2)
  expiresAt       DateTime
  convertedToPolicyId String?
  createdAt       DateTime   @default(now())

  @@index([memberId])
  @@index([type])
}

enum QuoteType {
  TERM_LIFE
  HOME
  AUTO
  TRAVEL
  CRITICAL_ILLNESS
  DISABILITY
}

// ============ APPOINTMENTS ============
model Appointment {
  id              String           @id @default(cuid())
  memberId        String
  member          Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          Branch?          @relation(fields: [branchId], references: [id])
  service         AppointmentType
  scheduledAt     DateTime
  durationMinutes Int              @default(60)
  advisorName     String?
  status          AppointmentStatus @default(SCHEDULED)
  videoUrl        String?
  notes           String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([memberId])
  @@index([scheduledAt])
}

enum AppointmentType {
  INSURANCE_QUOTE
  MORTGAGE_CONSULTATION
  WEALTH_REVIEW
  ESTATE_PLANNING
  BUSINESS_INSURANCE
  INTL_TRANSFERS
  FINANCIAL_CHECKUP
  NEW_MEMBER
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ============ MESSAGES ============
model MessageThread {
  id            String     @id @default(cuid())
  memberId      String
  member        Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  advisorId     String
  advisorName   String
  advisorRole   String
  subject       String?
  status        ThreadStatus @default(OPEN)
  lastMessageAt DateTime   @default(now())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  messages      Message[]

  @@index([memberId, lastMessageAt])
}

enum ThreadStatus {
  OPEN
  AWAITING_MEMBER
  AWAITING_ADVISOR
  CLOSED
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  fromType  MessageFromType
  fromId    String
  fromName  String
  content   String   @db.Text
  read      Boolean  @default(false)
  aiAssisted Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
}

enum MessageFromType {
  MEMBER
  ADVISOR
  AI
  SYSTEM
}

// ============ NOTIFICATIONS ============
model Notification {
  id        String              @id @default(cuid())
  memberId  String
  member    Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String              @db.Text
  iconKey   String?
  actionUrl String?
  actionLabel String?
  read      Boolean             @default(false)
  priority  NotificationPriority @default(NORMAL)
  createdAt DateTime            @default(now())

  @@index([memberId, read, createdAt])
}

enum NotificationType {
  RENEWAL
  SIGNATURE_REQUEST
  LIFE_EVENT
  ADVISOR_MESSAGE
  TRANSFER
  RATE_ALERT
  CLAIM_UPDATE
  APPOINTMENT
  SECURITY
  SYSTEM
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// ============ DOCUMENTS ============
model Document {
  id          String        @id @default(cuid())
  memberId    String
  member      Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  policyId    String?
  policy      Policy?       @relation(fields: [policyId], references: [id])
  claimId     String?
  claim       Claim?        @relation(fields: [claimId], references: [id])
  name        String
  type        DocumentType
  storageKey  String
  mimeType    String
  sizeBytes   Int
  signedAt    DateTime?
  signatureRequired Boolean @default(false)
  uploadedAt  DateTime      @default(now())

  @@index([memberId])
}

enum DocumentType {
  POLICY
  CLAIM
  STATEMENT
  TAX_SLIP
  SIGNATURE_REQUIRED
  ID_VERIFICATION
  OTHER
}

// ============ INTERNATIONAL TRANSFERS ============
model Transfer {
  id              String         @id @default(cuid())
  memberId        String
  member          Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trackingId      String         @unique
  fromAccountId   String
  recipientName   String
  recipientCity   String
  recipientCountry String
  amountCAD       Decimal        @db.Decimal(15, 2)
  exchangeRate    Decimal        @db.Decimal(10, 6)
  amountForeign   Decimal        @db.Decimal(15, 2)
  currency        String         @default("EUR")
  fee             Decimal        @db.Decimal(10, 2)
  status          TransferStatus @default(INITIATED)
  initiatedAt     DateTime       @default(now())
  deliveredAt     DateTime?

  @@index([memberId])
  @@index([trackingId])
}

enum TransferStatus {
  INITIATED
  PROCESSING
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

// ============ CREDIT SCORE ============
model CreditScore {
  id            String   @id @default(cuid())
  memberId      String   @unique
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  score         Int
  bureau        String   @default("Equifax")
  paymentHistory Int
  utilization   Int
  creditAge     Int
  recentInquiries Int
  lastUpdated   DateTime @default(now())
  history       Json?
}

// ============ FINANCIAL HEALTH ASSESSMENTS ============
model HealthAssessment {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  score       Int
  answers     Json
  report      String   @db.Text
  takenAt     DateTime @default(now())

  @@index([memberId, takenAt])
}

// ============ AUDIT LOG ============
model AuditLog {
  id        String   @id @default(cuid())
  memberId  String?
  action    String
  resource  String
  resourceId String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([memberId, createdAt])
  @@index([action, createdAt])
}

// ============ INVESTING (Wealthsimple-style) ============
model Portfolio {
  id            String   @id @default(cuid())
  memberId      String
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  accountId     String?
  name          String
  type          PortfolioType
  riskLevel     RiskLevel @default(BALANCED)
  totalValue    Decimal  @db.Decimal(15, 2) @default(0)
  totalDeposited Decimal @db.Decimal(15, 2) @default(0)
  cashBalance   Decimal  @db.Decimal(15, 2) @default(0)
  managed       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  holdings      Holding[]
  trades        Trade[]

  @@index([memberId])
}

enum PortfolioType {
  MANAGED
  SELF_DIRECTED
  CRYPTO
  TFSA
  RRSP
  FHSA
  RESP
  CASH
}

enum RiskLevel {
  CONSERVATIVE
  BALANCED
  GROWTH
  AGGRESSIVE
}

model Holding {
  id            String   @id @default(cuid())
  portfolioId   String
  portfolio     Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  symbol        String
  name          String
  assetType     AssetType
  quantity      Decimal  @db.Decimal(18, 8)
  avgCost       Decimal  @db.Decimal(15, 4)
  currentPrice  Decimal  @db.Decimal(15, 4)
  currency      String   @default("CAD")
  updatedAt     DateTime @updatedAt

  @@index([portfolioId])
}

enum AssetType {
  STOCK
  ETF
  CRYPTO
  BOND
  MUTUAL_FUND
  CASH
}

model Trade {
  id            String   @id @default(cuid())
  portfolioId   String
  portfolio     Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  memberId      String
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  symbol        String
  name          String
  assetType     AssetType
  side          TradeSide
  quantity      Decimal  @db.Decimal(18, 8)
  price         Decimal  @db.Decimal(15, 4)
  totalAmount   Decimal  @db.Decimal(15, 2)
  status        TradeStatus @default(FILLED)
  executedAt    DateTime @default(now())

  @@index([portfolioId])
  @@index([memberId, executedAt])
}

enum TradeSide {
  BUY
  SELL
}

enum TradeStatus {
  PENDING
  FILLED
  CANCELLED
  REJECTED
}

model Watchlist {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  symbol    String
  name      String
  assetType AssetType
  addedAt   DateTime @default(now())

  @@unique([memberId, symbol])
  @@index([memberId])
}

model SavingsGoal {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  name        String
  targetAmount Decimal @db.Decimal(15, 2)
  currentAmount Decimal @db.Decimal(15, 2) @default(0)
  targetDate  DateTime?
  icon        String?
  createdAt   DateTime @default(now())

  @@index([memberId])
}
